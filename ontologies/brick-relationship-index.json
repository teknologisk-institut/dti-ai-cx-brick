  "patterns": {
    "description": "Common triple patterns for AI-CX building models. Use these as templates when generating TTL in Phase 6.",
    "examples": [
      {
        "name": "Equipment → Point (sensor/setpoint linkage)",
        "description": "Every sensor, setpoint, command, or status is a brick:Point attached to its parent Equipment or Location via brick:hasPoint.",
        "triples": [
          "bldg:VE01 a brick:Air_Handling_Unit .",
          "bldg:VE01_TI1 a brick:Supply_Air_Temperature_Sensor .",
          "bldg:VE01 brick:hasPoint bldg:VE01_TI1 ."
        ]
      },
      {
        "name": "Equipment composition (hasPart)",
        "description": "Physical containment — a damper, valve, or fan is part of an AHU or VAV.",
        "triples": [
          "bldg:VE01 a brick:Air_Handling_Unit .",
          "bldg:VE01_SF1 a brick:Supply_Fan .",
          "bldg:VE01 brick:hasPart bldg:VE01_SF1 ."
        ]
      },
      {
        "name": "Flow topology (feeds)",
        "description": "Upstream/downstream flow — heating plant feeds AHU feeds Zone.",
        "triples": [
          "bldg:VA07 brick:feeds bldg:VE01 .",
          "bldg:VE01 brick:feeds bldg:Z_101 ."
        ]
      },
      {
        "name": "Spatial location (hasLocation)",
        "description": "Equipment or zones located in a physical space.",
        "triples": [
          "bldg:VE01 brick:hasLocation bldg:level_1 .",
          "bldg:Z_101 brick:hasLocation bldg:room_1_01 ."
        ]
      },
      {
        "name": "Timeseries reference (TSDB linkage)",
        "description": "Connects a Brick Point to its timeseries data in TimescaleDB. This is the critical link between the semantic model and live data. ref:hasTimeseriesId holds the object name from objects.json (tsdb.id).",
        "triples": [
          "bldg:Z_102_TS1 a brick:Zone_Air_Temperature_Sensor .",
          "bldg:Z_102_TS1 ref:hasExternalReference [",
          "    a ref:TimeseriesReference ;",
          "    ref:hasTimeseriesId \"Z_102_TS1\" ;",
          "] ."
        ]
      },
      {
        "name": "Metering (meters)",
        "description": "A meter measures consumption/production of a substance for an entity.",
        "triples": [
          "bldg:VA07_QM1 a brick:Thermal_Power_Meter .",
          "bldg:VA07_QM1 brick:meters bldg:VA07 ."
        ]
      },
      {
        "name": "Spatial hierarchy (REC containment)",
        "description": "Building → Level → Room containment uses rec: classes (brick: location classes are deprecated in 1.4.4). Space-to-space uses rec:isPartOf/rec:hasPart.",
        "triples": [
          "bldg:Building a rec:Building .",
          "bldg:level_1 a rec:Level ; rec:levelNumber 1 ; rec:isPartOf bldg:Building .",
          "bldg:room_1_02 a rec:Office ; rec:isPartOf bldg:level_1 ."
        ]
      },
      {
        "name": "Zone/equipment placement (hasLocation)",
        "description": "Non-spatial entities (zones, equipment) placed in a space use brick:hasLocation (equivalent to rec:locatedIn), not rec:isPartOf.",
        "triples": [
          "bldg:Z_102 a brick:HVAC_Zone ; brick:hasLocation bldg:room_1_02 .",
          "bldg:VE01 a brick:Air_Handling_Unit ; brick:hasLocation bldg:level_1 ."
        ]
      }
    ]
  }
}